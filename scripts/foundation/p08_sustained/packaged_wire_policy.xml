<busconfig>
  <type>system</type><user>messagebus</user><auth>EXTERNAL</auth>
  <listen>unix:path=/run/osbus-p08/socket/bus</listen>
  <limit name="max_completed_connections">7</limit>
  <limit name="max_incomplete_connections">1</limit>
  <limit name="max_connections_per_user">7</limit>
  <limit name="max_message_size">262144</limit>
  <limit name="max_message_unix_fds">16</limit>
  <limit name="max_incoming_bytes">262144</limit>
  <limit name="max_outgoing_bytes">262144</limit>
  <limit name="max_incoming_unix_fds">16</limit>
  <limit name="max_outgoing_unix_fds">16</limit>
  <limit name="max_names_per_connection">4</limit>
  <limit name="max_match_rules_per_connection">4</limit>
  <limit name="max_replies_per_connection">4</limit>
  <limit name="reply_timeout">100</limit>
  <policy context="default">
    <deny user="*"/><allow user="0"/><allow user="1100"/><allow user="1101"/>
    <deny own="*"/><deny own="org.foundation.Forbidden"/>
  </policy>
  <policy user="0">
    <allow send_type="method_call"/><allow send_type="method_return" send_requested_reply="false"/>
    <allow send_type="error" send_requested_reply="false"/><allow send_type="signal"/>
    <allow receive_type="method_call"/><allow receive_type="method_return" receive_requested_reply="false"/>
    <allow receive_type="error" receive_requested_reply="false"/><allow receive_type="signal"/>
    <allow own_prefix="org.foundation.Root"/>
  </policy>
  <policy user="1100">
    <allow send_type="method_call"/><allow send_type="method_return" send_requested_reply="false"/>
    <allow send_type="error" send_requested_reply="false"/><allow send_type="signal"/>
    <allow receive_type="method_call"/><allow receive_type="method_return" receive_requested_reply="false"/>
    <allow receive_type="error" receive_requested_reply="false"/><allow receive_type="signal"/>
    <allow own="org.foundation.Observer"/>
    <deny send_destination="org.foundation.Service.Protected" send_requested_reply="true"/>
  </policy>
  <policy user="1101">
    <allow send_type="method_call"/><allow send_type="method_return" send_requested_reply="false"/>
    <allow send_type="error" send_requested_reply="false"/><allow send_type="signal"/>
    <allow receive_type="method_call"/><allow receive_type="method_return" receive_requested_reply="false"/>
    <allow receive_type="error" receive_requested_reply="false"/><allow receive_type="signal"/>
    <allow own_prefix="org.foundation.Service"/>
    <deny receive_type="method_call" receive_interface="org.foundation.ReceiveDenied" receive_requested_reply="true"/>
    <deny receive_type="signal" receive_interface="org.foundation.ReceiveDenied" receive_requested_reply="true"/>
    <deny receive_type="method_return" receive_sender="org.foundation.Observer" receive_requested_reply="true"/>
  </policy>
</busconfig>
